# ---- LLM (Gemma from AI Grid, or any OpenAI-compatible provider) ----
# Copy these three values from your AI Grid dashboard / docs.
LLM_BASE_URL=https://YOUR-AI-GRID-ENDPOINT/v1
LLM_API_KEY=your_ai_grid_key_here
LLM_MODEL=your-gemma-model-name

# Gemma switches (change only if you get errors):
# false = do not ask the API for JSON mode (use if the provider rejects it)
LLM_JSON_MODE=true
# true = merge the system prompt into the user message (use if the provider says "system role not supported")
LLM_MERGE_SYSTEM=false

# Max characters of the document sent to the model (about 4 characters = 1 token).
# Lower it if your Gemma context window is small.
MAX_DOC_CHARS=24000

# ---- Market news (optional) ----
NEWS_API_KEY=your_news_api_key_here

# ---- Server ----
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
